---
const year = new Date().getFullYear();
---

<footer class="w-full px-6 sm:px-10 pb-24 md:pb-12">
  <div class="max-w-5xl mx-auto">
    <div
      class="pt-8 border-t border-[var(--border)] flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="font-mono text-xs text-[var(--muted)]">
        © {year} Félix Jean-Baptiste — Ingénieur Backend Freelance & IA
      </p>
      <p class="font-mono text-xs text-[var(--muted)]">
        Conçu avec Astro · React · Tailwind
      </p>
    </div>
  </div>
</footer>
