---
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";

const socials = [
  { label: "GitHub", href: "https://github.com/felixjb91" },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/felix-jean-baptiste-dev",
  },
  {
    label: "felixjb91@gmail.com",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=felixjb91@gmail.com&su=Salut%20Félix%20!",
  },
];

const stack = ["Java", "Spring Boot", "LangChain4J", "AWS", "PostgreSQL"];
---

<section id="home" class="scroll-mt-24">
  <div class="max-w-5xl mx-auto">
    <!-- Hero -->
    <div
      class="min-h-[88vh] flex flex-col justify-center py-24 md:py-32 border-b border-[var(--border)]"
    >
      <div class="grid lg:grid-cols-[1fr_auto] lg:gap-16 gap-10 items-start">
        <!-- Colonne principale -->
        <div class="max-w-3xl">
          <p
            class="font-mono text-xs sm:text-sm tracking-[0.18em] uppercase text-[var(--muted)] animate-fade-up"
          >
            Félix Jean-Baptiste
            <span class="text-[var(--accent)]">— Ingénieur logiciel · Paris</span>
          </p>

          <h1
            class="mt-7 font-serif font-normal tracking-[-0.01em] text-[var(--text)] leading-[1.18] text-pretty animate-fade-up [animation-delay:80ms]"
            style="font-size: clamp(1.8rem, 3.4vw, 2.9rem);"
          >
            Je conçois des systèmes backend fiables, et j'y intègre l'IA quand
            elle apporte une <span class="text-[var(--accent)]">vraie valeur</span>.
          </h1>

          <p
            class="mt-8 text-lg md:text-xl leading-relaxed text-[var(--muted)] max-w-2xl animate-fade-up [animation-delay:160ms]"
          >
            ~7 ans à construire des architectures Java / Spring Boot robustes et
            testées. J'étends aujourd'hui ce savoir-faire aux agents et aux
            systèmes RAG — la même exigence d'ingénierie, appliquée aux LLM.
          </p>

          <!-- Ligne de preuves -->
          <ul
            class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs sm:text-sm text-[var(--muted)] animate-fade-up [animation-delay:240ms]"
          >
            {
              stack.map((tech, i) => (
                <>
                  {i > 0 && (
                    <li aria-hidden="true" class="text-[var(--border)]">
                      ·
                    </li>
                  )}
                  <li class="uppercase tracking-wider">{tech}</li>
                </>
              ))
            }
          </ul>

          <!-- Liens -->
          <div
            class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 font-mono text-sm animate-fade-up [animation-delay:320ms]"
          >
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-1 text-[var(--text)] underline decoration-[var(--border)] decoration-1 underline-offset-[6px] transition-colors hover:decoration-[var(--accent)] hover:text-[var(--accent)]"
                >
                  {s.label}
                  <span
                    aria-hidden="true"
                    class="transition-transform group-hover:translate-x-0.5"
                  >
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Bloc méta (desktop) -->
        <dl
          class="hidden lg:block w-56 font-mono text-xs space-y-5 border-l border-[var(--border)] pl-6 animate-fade-up [animation-delay:220ms]"
        >
          <div>
            <dt class="uppercase tracking-[0.16em] text-[var(--muted)]">
              Disponibilité
            </dt>
            <dd class="mt-1.5 text-[var(--text)] flex items-center gap-2">
              <span
                class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent)]"
                aria-hidden="true"></span>
              Ouvert aux missions
            </dd>
          </div>
          <div>
            <dt class="uppercase tracking-[0.16em] text-[var(--muted)]">Lieu</dt>
            <dd class="mt-1.5 text-[var(--text)]">Paris · Remote</dd>
          </div>
          <div>
            <dt class="uppercase tracking-[0.16em] text-[var(--muted)]">Focus</dt>
            <dd class="mt-1.5 text-[var(--text)]">Backend · IA</dd>
          </div>
        </dl>
      </div>

      <div class="mt-16">
        <LogoWall />
      </div>
    </div>

    <!-- 01 — Ce que je fais -->
    <SkillsList client:visible />
  </div>
</section>
