<section
  id="contact"
  class="py-20 md:py-28 border-t border-[var(--border)] scroll-mt-24"
>
  <div class="max-w-5xl mx-auto">
    <p
      class="font-mono text-xs sm:text-sm tracking-[0.18em] uppercase text-[var(--muted)]"
    >
      <span class="text-[var(--accent)]">03</span> — Contact
    </p>
    <h2
      id="contact-heading"
      class="mt-4 font-serif font-medium text-3xl md:text-4xl text-[var(--text)] mb-12"
    >
      Un système à concevoir, une IA à intégrer ? Parlons-en.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <!-- Coordonnées -->
      <div>
        <p class="text-[var(--muted)] leading-relaxed max-w-sm">
          Une mission à cadrer, une architecture à challenger ou une simple
          question technique ? Freelance disponible, je reviens vers vous
          rapidement.
        </p>
        <dl class="mt-8 space-y-4 font-mono text-sm">
          <div class="flex flex-col gap-1">
            <dt class="uppercase tracking-[0.16em] text-xs text-[var(--muted)]">
              Email
            </dt>
            <dd>
              <a
                href="mailto:felixjb91@gmail.com"
                class="text-[var(--text)] underline decoration-[var(--border)] decoration-1 underline-offset-[6px] hover:decoration-[var(--accent)] hover:text-[var(--accent)] transition-colors"
                >felixjb91@gmail.com</a
              >
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="uppercase tracking-[0.16em] text-xs text-[var(--muted)]">
              Lieu
            </dt>
            <dd class="text-[var(--text)]">Paris, France · Remote</dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="uppercase tracking-[0.16em] text-xs text-[var(--muted)]">
              Réseaux
            </dt>
            <dd class="flex gap-5 text-[var(--text)]">
              <a
                href="https://github.com/felixjb91"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-[var(--border)] decoration-1 underline-offset-[6px] hover:decoration-[var(--accent)] hover:text-[var(--accent)] transition-colors"
                >GitHub ↗</a
              >
              <a
                href="https://linkedin.com/in/felix-jean-baptiste-dev"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-[var(--border)] decoration-1 underline-offset-[6px] hover:decoration-[var(--accent)] hover:text-[var(--accent)] transition-colors"
                >LinkedIn ↗</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <!-- Formulaire -->
      <div>
        <form
          id="contact-form"
          aria-labelledby="contact-heading"
          class="flex flex-col gap-7"
        >
          <div class="flex flex-col gap-2">
            <label
              for="name"
              class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--muted)]"
              >Nom</label
            >
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Votre nom"
              aria-required="true"
              aria-describedby="form-error"
              class="w-full bg-transparent text-[var(--text)] border-0 border-b border-[var(--border)] rounded-none py-2 placeholder:text-[var(--muted)]/60 focus:outline-none focus:border-[var(--accent)] transition-colors"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              for="email"
              class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--muted)]"
              >Email</label
            >
            <input
              id="email"
              type="email"
              name="email"
              placeholder="vous@exemple.com"
              aria-describedby="form-error"
              class="w-full bg-transparent text-[var(--text)] border-0 border-b border-[var(--border)] rounded-none py-2 placeholder:text-[var(--muted)]/60 focus:outline-none focus:border-[var(--accent)] transition-colors"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              for="phone"
              class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--muted)]"
              >Téléphone <span class="normal-case">(optionnel)</span></label
            >
            <input
              id="phone"
              type="tel"
              name="phone"
              placeholder="+33 6 12 34 56 78"
              aria-describedby="form-error"
              class="w-full bg-transparent text-[var(--text)] border-0 border-b border-[var(--border)] rounded-none py-2 placeholder:text-[var(--muted)]/60 focus:outline-none focus:border-[var(--accent)] transition-colors"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label
              for="message"
              class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--muted)]"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              placeholder="Votre projet en quelques lignes…"
              rows="5"
              aria-required="true"
              aria-describedby="form-error"
              class="w-full bg-transparent text-[var(--text)] border-0 border-b border-[var(--border)] rounded-none py-2 placeholder:text-[var(--muted)]/60 focus:outline-none focus:border-[var(--accent)] transition-colors resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="mt-2 self-start px-7 py-3 bg-[var(--accent)] text-[var(--bg)] font-mono text-sm tracking-wide rounded-md transition-opacity hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
          >
            <span id="btn-text">Envoyer le message</span>
            <svg id="btn-loader" class="hidden animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>
        <div
          id="form-error"
          role="alert"
          aria-live="polite"
          class="hidden mt-5 text-red-600 dark:text-red-400 text-sm"
        >
        </div>
        <div
          id="form-message"
          role="status"
          aria-live="polite"
          class="hidden justify-start items-center mt-5 text-[var(--text)] text-lg"
        >
          ✅ Merci pour votre message !
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { parsePhoneNumberFromString } from 'libphonenumber-js';

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const formMessage = document.getElementById("form-message");
  const formError = document.getElementById("form-error");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const btnLoader = document.getElementById("btn-loader");

  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError!.classList.add("hidden");
    formError!.textContent = "";

    const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
    const phone = (form.elements.namedItem("phone") as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem("message") as HTMLTextAreaElement).value.trim();

    const errors: string[] = [];

    if (!name) {
      errors.push("Le nom est requis");
    }

    if (!email && !phone) {
      errors.push("L'email ou le téléphone est requis");
    }

    if (email && !emailRegex.test(email)) {
      errors.push("Format d'email invalide");
    }

    if (phone) {
      const phoneNumber = phone.startsWith('+')
        ? parsePhoneNumberFromString(phone)
        : parsePhoneNumberFromString(phone, 'FR');

      if (!phoneNumber) {
        errors.push("Numéro de téléphone non reconnu");
      } else if (!phoneNumber.isValid()) {
        errors.push("Numéro de téléphone invalide (vérifiez le nombre de chiffres)");
      }
    }

    if (!message) {
      errors.push("Un message est requis");
    }

    if (errors.length > 0) {
      formError!.innerHTML = errors.join("<br>");
      formError!.classList.remove("hidden");
      return;
    }

    // Show loader
    submitBtn.disabled = true;
    btnText!.classList.add("hidden");
    btnLoader!.classList.remove("hidden");

    try {
      const response = await fetch("https://n8n.feltech.fr/webhook/portfolio/contact-form", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, phone, message }),
      });
      if (response.ok) {
        form.reset();
        form.style.display = "none";
        formMessage!.classList.remove("hidden");
        formMessage!.classList.add("flex");
      } else {
        console.error("Error response:", response.status);
        formError!.textContent = "Une erreur est survenue lors de l'envoi.";
        formError!.classList.remove("hidden");
      }
    } catch (error) {
      console.error("Error:", error);
      formError!.textContent = "Une erreur est survenue lors de l'envoi.";
      formError!.classList.remove("hidden");
    } finally {
      // Hide loader
      submitBtn.disabled = false;
      btnText!.classList.remove("hidden");
      btnLoader!.classList.add("hidden");
    }
  });
</script>
