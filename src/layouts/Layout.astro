    <title>{title}</title>
  </head>
  <body class="bg-bg font-sans text-ink antialiased">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Thème clair (par défaut, prioritaire) */
    --bg: #fbfaf7;
    --surface: #ffffff;
    --text: #1a1a18;
    --muted: #6b6862;
    --accent: #2742c9;
    --border: #e6e3dc;

    /* Aliases de compatibilité (anciens composants) */
    --background: var(--bg);
    --background-card: var(--surface);
    --component-bg: var(--surface);
    --sec: var(--accent);
    --white: var(--text);
    --white-icon: var(--muted);
    --white-icon-tr: var(--border);

    color-scheme: light;
  }

  [data-theme="dark"] {
    --bg: #111110;
    --surface: #191917;
    --text: #eceae3;
    --muted: #9a968c;
    --accent: #8aa0ff;
    --border: #2a2a26;

    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
    font-display: swap;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Inter Variable", Inter, system-ui, sans-serif;
    min-height: 100vh;
  }

  *::selection {
    background-color: var(--accent);
    color: var(--bg);
  }

  /* Crossfade des couleurs au changement de thème */
  @media (prefers-reduced-motion: no-preference) {
    *,
    *::before,
    *::after {
      transition:
        background-color 0.25s ease,
        border-color 0.25s ease;
    }
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 12px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
    border: 3px solid var(--bg);
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--muted);
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--border) var(--bg);
  }

  /* Masque la scrollbar des carrousels (complément WebKit) */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  /* Accessibilité : réduit les animations à la demande */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
